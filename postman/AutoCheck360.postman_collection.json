{
  "info": {
    "_postman_id": "a93e360b-8d01-499c-b16f-autocheck360",
    "name": "AutoCheck 360 - Gen AI Vistorias",
    "description": "Coleção de endpoints da API AutoCheck 360 (Spring Boot 3, Gemini Vision & Spring Security)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login - Vistoriador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set(\"jwt_token\", data.token);",
                  "    console.log(\"Token JWT capturado com sucesso!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vistoriador@autocheck.com\",\n  \"senha\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Locadora",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"locadora@autocheck.com\",\n  \"senha\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Vistorias com Inteligência Artificial",
      "item": [
        {
          "name": "Analisar Vistoria (Foto com Gemini Vision)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "imagem",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "tipo",
                  "value": "ENTRADA",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vistorias/1/analisar",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vistorias", "1", "analisar"]
            }
          }
        },
        {
